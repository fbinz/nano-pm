#: static/js/nano.js:317
msgid "Drop on another task to create a dependency."
msgstr "Auf eine andere Aufgabe ziehen, um eine Abhängigkeit zu erstellen."

#: static/js/nano.js:353
msgid ""
"A new task row is highlighted. Click for a 7-day task, or drag to set its "
"dates. Press Escape to cancel."
msgstr ""
"Eine neue Aufgabenzeile ist hervorgehoben. Für eine 7-tägige Aufgabe klicken "
"oder ziehen, um ihren Zeitraum festzulegen. Zum Abbrechen Escape drücken."

#: static/js/nano.js:354
msgid ""
"Milestone placement: Move over the timeline to preview a date, then click to "
"place it. Press Escape to cancel."
msgstr ""
"Meilenstein platzieren: Den Mauszeiger über die Zeitachse bewegen, um ein "
"Datum als Vorschau anzuzeigen, und zum Platzieren klicken. Zum Abbrechen "
"Escape drücken."

#: static/js/nano.js:527 static/js/nano.js:550
msgid "New task"
msgstr "Neue Aufgabe"

#: static/js/nano.js:529
msgid "Click or drag the timeline to schedule it"
msgstr "Zeitachse anklicken oder ziehen, um sie einzuplanen"

#: static/js/nano.js:534
msgid "Cancel new task"
msgstr "Neue Aufgabe abbrechen"

#: static/js/nano.js:545
msgid "Schedule new task"
msgstr "Neue Aufgabe einplanen"

#: static/js/nano.js:745
msgid "day"
msgstr "Tag"

#: static/js/nano.js:745
msgid "days"
msgstr "Tage"

#: static/js/nano.js:746
msgid "later"
msgstr "später"

#: static/js/nano.js:746
msgid "earlier"
msgstr "früher"

#: static/js/workload.js:34
msgid "allocated"
msgstr "zugewiesen"

#: static/js/workload.js:35 static/js/workload.js:77
msgid "Enter whole percentages between 0 and 100."
msgstr "Gib ganze Prozentwerte zwischen 0 und 100 ein."

#: static/js/workload.js:36
msgid "%(amount)s% over — reduce an allocation"
msgstr "%(amount)s% zu viel — reduziere einen Anteil"

#: static/js/workload.js:37
msgid "%(amount)s% left to allocate"
msgstr "%(amount)s% noch zu verteilen"

#: static/js/workload.js:37
msgid "100% allocated"
msgstr "100% zugewiesen"

#: static/js/workload.js:50
msgid "Fill remaining %(amount)s%"
msgstr "Verbleibende %(amount)s% zuweisen"

#: static/js/workload.js:77
msgid "Project allocations cannot exceed their category percentage."
msgstr "Projektanteile dürfen den Anteil ihrer Kategorie nicht überschreiten."

#: static/js/workload.js:80
msgid "%(amount)s% over category"
msgstr "%(amount)s% über dem Kategorieanteil"

#: static/js/workload.js:81
msgid "%(assigned)s% assigned · %(unspecified)s% unspecified"
msgstr "%(assigned)s% zugewiesen · %(unspecified)s% ohne Zuordnung"

#: static/js/workload.js:112
msgid "Unspecified: %(amount)s%"
msgstr "Ohne Zuordnung: %(amount)s%"

